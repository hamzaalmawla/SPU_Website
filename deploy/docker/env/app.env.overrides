# Keys make-app-env.sh sets on top of the cPanel .env. Everything else (APP_KEY,
# ADMIN_PATH, MAIL_*, SENTRY_*, OpenAI keys, WEBHOOK_SECRET, ...) is copied
# unchanged: APP_KEY above all, or encrypted data stops opening.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://spu.edu.sy
APP_CANONICAL_URL=https://spu.edu.sy
ENFORCE_CANONICAL_HOST=true
SESSION_DOMAIN=spu.edu.sy
DB_HOST=db
DB_PORT=3306
OLD_DB_HOST=db
OLD_DB_PORT=3306
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Caddy forwards Accept-Encoding (cPanel's nginx stripped it), so gzip is
# negotiated again rather than forced on every client.
COMPRESS_WITHOUT_ACCEPT_ENCODING=false
LEGACY_MEDIA_ENABLED=true
