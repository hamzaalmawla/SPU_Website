# /srv/spu/stack.env - settings for docker compose (not for Laravel).
# chmod 600. Laravel's own settings are in /srv/spu/app.env.

SPU_ROOT=/srv/spu
SPU_IMAGE_TAG=current

# Database (MariaDB 10.11). The site's database and user keep their cPanel
# names, so app.env's DB_DATABASE / DB_USERNAME stay as they were; only
# DB_HOST (db) and DB_PASSWORD change. Generate: openssl rand -base64 30
DB_DATABASE=spuedu_v2
DB_USERNAME=spuedu_v2usr
DB_PASSWORD=
DB_ROOT_PASSWORD=
# About half the VPS's RAM when the database is on the same machine.
INNODB_BUFFER_POOL_SIZE=1G

# TLS and host names (see caddy/Caddyfile).
SPU_CANONICAL_HOST=spu.edu.sy
SPU_ALIAS_HOSTS="www.spu.edu.sy v2.spu.edu.sy"
# internal until DNS moves (test with --resolve), then files or auto.
SPU_TLS_MODE=internal
# Keep identical to the application's HSTS (config/security.php, HSTS_* in app.env).
SPU_HSTS="max-age=604800; includeSubDomains"

# The old site's media and its live PHP apps (/forms, /Medicine, /spuh):
#   local  = copied to /srv/spu/data (the goal)
#   remote = proxied to the old host while a copy is unfinished
SPU_LEGACY_MEDIA=local
SPU_LEGACY_APPS=local
SPU_LEGACY_ORIGIN=https://184.107.185.129
# legacy-apps runs the /forms, /Medicine and /spuh container; drop it if
# SPU_LEGACY_APPS is remote or off.
COMPOSE_PROFILES=legacy-apps

# PHP workers in the web container (each ~60-100 MB).
APACHE_MAX_WORKERS=40
