## Local development example only.
## Do not copy this file to staging or production; use `.env.production.example`
## and `Docs/production-env-baseline.md` as the production gate.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_CANONICAL_URL=http://localhost
ENFORCE_CANONICAL_HOST=false

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spu_website
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

 OLD_DB_CONNECTION=mysql
 OLD_DB_HOST=127.0.0.1
 OLD_DB_PORT=3306
 OLD_DB_DATABASE=spu_legacy
 OLD_DB_USERNAME=root
 OLD_DB_PASSWORD=
 OLD_DB_CHARSET=utf8mb4
 OLD_DB_COLLATION=utf8mb4_unicode_ci
 OLD_DB_ENGINE=InnoDB

ADMIN_NAME="SPU Super Admin"
ADMIN_EMAIL=admin@spu.edu.sy
ADMIN_PASSWORD=local-development-password

# Configure these only when explicitly running HrUserSeeder.
HR_NAME="SPU Human Resources"
HR_EMAIL=
HR_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_WEBP_DRIVER=auto
MEDIA_WEBP_QUALITY=82
LEGACY_MEDIA_ENABLED=true
# Set only when legacy files remain under a separate public URL/path.
# LEGACY_MEDIA_BASE_URL=https://legacy.example.test
TRUSTED_PORTAL_HOSTS=my.spu.edu.sy
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_RELEASE=local
# CACHE_PREFIX=spu-cache
CACHE_LIMITER=rate-limiter
CACHE_WEBHOOK_STORE=webhook
WEBHOOK_CACHE_DRIVER=file
RATE_LIMIT_CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Comma-separated staff recipients for public form notifications.
FORM_ADMIN_RECIPIENTS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Continuity (Legacy Redirect Validation)
# ──────────────────────────────────────────────
# Comma-separated list of allowed external redirect hosts.
# Relative paths and spu.edu.sy subdomains are always allowed.
# CONTINUITY_ALLOWED_HOSTS=spu.edu.sy

# ──────────────────────────────────────────────
# Audit Log Retention
# ──────────────────────────────────────────────
# Number of days to retain audit log records. Set to 0 to retain all.
# AUDIT_RETENTION_DAYS=90

# ──────────────────────────────────────────────
# Webhook HMAC Verification
# ──────────────────────────────────────────────
# Shared secret for verifying inbound webhook signatures.
# Webhook consumers must sign "timestamp.body" with HMAC-SHA256
# and send X-Webhook-Signature, X-Webhook-Timestamp, and X-Webhook-Nonce.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# WEBHOOK_SECRET=

# Production defaults to requiring confirmed TOTP for these admin roles.
REQUIRE_PRIVILEGED_ADMIN_2FA=false
PRIVILEGED_ADMIN_2FA_ROLES=super_admin,editor,faculty_editor,hr

# ──────────────────────────────────────────────
# Sentry Error Tracking & APM
# ──────────────────────────────────────────────
# Sentry DSN — leave empty to disable Sentry entirely.
# Obtain from your Sentry project settings: Settings → Client Keys (DSN).
SENTRY_LARAVEL_DSN=
# Fraction of requests to trace for performance monitoring (0.0–1.0).
# Production recommendation: 0.2 (20%). Set to 0 to disable tracing.
SENTRY_TRACES_SAMPLE_RATE=0
