APP_NAME="Syrian Private University"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_UNIQUE_PRODUCTION_KEY
APP_DEBUG=false
APP_URL=https://spu.edu.sy
APP_CANONICAL_URL=https://spu.edu.sy
ENFORCE_CANONICAL_HOST=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spu_website
DB_USERNAME=spu_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

OLD_DB_CONNECTION=mysql
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_DATABASE=spu_legacy
OLD_DB_USERNAME=spu_legacy_readonly
OLD_DB_PASSWORD=REPLACE_WITH_STRONG_LEGACY_DATABASE_PASSWORD
OLD_DB_CHARSET=utf8mb4
OLD_DB_COLLATION=utf8mb4_unicode_ci
OLD_DB_ENGINE=InnoDB

ADMIN_NAME="SPU Super Admin"
ADMIN_EMAIL=admin@spu.edu.sy
ADMIN_PASSWORD=REPLACE_WITH_ONE_TIME_STRONG_BOOTSTRAP_PASSWORD

# Required only when explicitly provisioning the HR admin account.
HR_NAME="SPU Human Resources"
HR_EMAIL=REPLACE_WITH_HR_EMAIL
HR_PASSWORD=REPLACE_WITH_STRONG_HR_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.spu.edu.sy
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Leave unset when old files are served from the same cPanel public root.
LEGACY_MEDIA_ENABLED=true
# LEGACY_MEDIA_BASE_URL=https://legacy.example.test
TRUSTED_PORTAL_HOSTS=my.spu.edu.sy
# The cPanel host has neither Redis nor Memcached. Do not set these to redis
# without confirming a Redis server actually exists -- the application boots,
# then fails on the first cache read. file benchmarks ~5x faster than database
# here and keeps page HTML out of the database.
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_RELEASE=REPLACE_WITH_DEPLOYMENT_RELEASE_ID
# Optional base prefix; CACHE_RELEASE is appended by config/cache.php.
# CACHE_PREFIX=spu-cache
CACHE_LIMITER=rate-limiter
CACHE_WEBHOOK_STORE=webhook
# How long a rendered public page is kept. Invalidation is explicit -- every
# publish path flushes the public-pages tag -- so expiry is only the backstop
# for a flush that never happened. Lower it only to diagnose a staleness bug.
CACHE_PUBLIC_PAGE_TTL=3600
# Collapses Blade's indentation out of HTML responses. Worth ~30% of every
# page while the proxy does not compress; turn it off once gzip is enabled
# upstream, or when you need to read the rendered markup.
MINIFY_HTML=true

# Only relevant if a Redis server is actually provisioned; unused on the
# current cPanel host.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
WEBHOOK_CACHE_DRIVER=file
REDIS_WEBHOOK_CONNECTION=default
RATE_LIMIT_CACHE_DRIVER=file
REDIS_RATE_LIMIT_CONNECTION=default

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@spu.edu.sy"
MAIL_FROM_NAME="${APP_NAME}"
# Optional comma-separated staff recipients; eligible admin/editor users are also notified.
FORM_ADMIN_RECIPIENTS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

REQUIRE_PRIVILEGED_ADMIN_2FA=true
PRIVILEGED_ADMIN_2FA_ROLES=super_admin,editor,faculty_editor,hr

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Sentry Error Tracking & APM
# ──────────────────────────────────────────────
# Sentry DSN — required for production error tracking.
# Obtain from your Sentry project settings: Settings → Client Keys (DSN).
SENTRY_LARAVEL_DSN=REPLACE_WITH_SENTRY_DSN
# Fraction of requests to trace for performance monitoring (0.0–1.0).
# 0.2 = 20% of requests. Adjust based on traffic volume.
SENTRY_TRACES_SAMPLE_RATE=0.2

# ──────────────────────────────────────────────
# Analytics
# ──────────────────────────────────────────────
# Leave both unset to keep analytics off and the strict CSP unchanged.
# Setting these widens script-src / connect-src for the provider only.
# See Docs/analytics-and-csp.md before enabling.
ANALYTICS_PROVIDER=
ANALYTICS_GA4_MEASUREMENT_ID=
ANALYTICS_ENABLE_NON_PRODUCTION=false
